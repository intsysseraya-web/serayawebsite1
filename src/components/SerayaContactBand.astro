---
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = "Contact",
  title = "Send quantities, targets, and constraints.",
  body = "No web form for now. Email your RFQ and Seraya replies with availability, lead time, warranty path, and the next practical step.",
} = Astro.props;
---

<section id="contact" class="px-5 pb-24" data-reveal>
  <div class="seraya-contact-band mx-auto grid w-full max-w-7xl gap-8 rounded-lg border border-white/10 bg-white/[0.04] p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">{eyebrow}</p>
      <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
        {title}
      </h2>
      <p class="mt-5 max-w-2xl leading-8 text-seraya-muted">
        {body}
      </p>
      <p class="mt-4 text-sm text-seraya-muted">Kuala Lumpur, Malaysia</p>
    </div>
    <a
      class="inline-flex justify-center rounded-md bg-seraya-accent px-5 py-3 text-sm font-semibold text-black transition hover:bg-seraya-cyan"
      href="mailto:hello@serayasystem.com"
    >
      hello@serayasystem.com
    </a>
  </div>
</section>
