<div class="seraya-hero-visual" aria-hidden="true">
  <picture class="seraya-hero-picture">
    <source srcset="/assets/hero/seraya-integration-core-global.webp" type="image/webp" />
    <img
      src="/assets/hero/seraya-integration-core-global.webp"
      alt=""
      width="1672"
      height="941"
      decoding="async"
      fetchpriority="high"
      class="seraya-hero-image h-full w-full opacity-95"
    />
  </picture>
  <canvas class="seraya-hero-canvas" data-seraya-hero-canvas></canvas>
  <div class="seraya-hero-scan"></div>
</div>

<script>
  const canvas = document.querySelector("[data-seraya-hero-canvas]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const smallViewport = window.matchMedia("(max-width: 767px)").matches;
  const coarsePointer = window.matchMedia("(pointer: coarse)").matches;

  if (canvas instanceof HTMLCanvasElement && !reduceMotion && !(smallViewport && coarsePointer)) {
    initHero(canvas);
  }

  async function initHero(canvas) {
    const THREE = await import("three");
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 80);
    const renderer = new THREE.WebGLRenderer({
      alpha: true,
      antialias: true,
      canvas,
      powerPreference: "high-performance",
      preserveDrawingBuffer: true,
    });

    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.45));

    let isVisible = true;
    let frameId = 0;
    let pointerX = 0;
    let pointerY = 0;

    const teal = new THREE.Color("#24d6b3");
    const cyan = new THREE.Color("#7bdff2");
    const amber = new THREE.Color("#f5a524");
    const steel = new THREE.Color("#7b8b95");

    const root = new THREE.Group();
    scene.add(root);

    const hardware = new THREE.Group();
    hardware.position.set(1.45, -0.55, 0);
    hardware.rotation.set(-0.08, -0.34, 0.05);
    root.add(hardware);

    const darkMetal = new THREE.MeshStandardMaterial({
      color: "#111820",
      metalness: 0.72,
      roughness: 0.38,
    });
    const edgeMetal = new THREE.MeshStandardMaterial({
      color: "#25313a",
      emissive: "#071012",
      metalness: 0.85,
      roughness: 0.26,
    });
    const glowTeal = new THREE.MeshStandardMaterial({
      color: "#24d6b3",
      emissive: "#24d6b3",
      emissiveIntensity: 1.35,
      metalness: 0.2,
      roughness: 0.2,
    });
    const glowAmber = new THREE.MeshStandardMaterial({
      color: "#f5a524",
      emissive: "#f5a524",
      emissiveIntensity: 1.6,
      metalness: 0.2,
      roughness: 0.24,
    });

    const base = new THREE.Mesh(new THREE.BoxGeometry(2.85, 0.22, 1.18), darkMetal);
    base.position.set(0, -0.12, 0);
    hardware.add(base);

    const chassis = new THREE.Mesh(new THREE.BoxGeometry(1.42, 0.54, 0.82), edgeMetal);
    chassis.position.set(0.3, 0.26, 0.04);
    hardware.add(chassis);

    const wire = new THREE.LineSegments(
      new THREE.EdgesGeometry(chassis.geometry),
      new THREE.LineBasicMaterial({ color: "#7bdff2", transparent: true, opacity: 0.34 }),
    );
    wire.position.copy(chassis.position);
    hardware.add(wire);

    for (let i = 0; i < 7; i += 1) {
      const board = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.38, 0.66), darkMetal);
      board.position.set(-0.22 + i * 0.12, 0.36, 0.04);
      board.rotation.z = 0.04;
      hardware.add(board);

      const status = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.025, 0.055), i % 3 === 0 ? glowAmber : glowTeal);
      status.position.set(board.position.x, 0.58, -0.32);
      hardware.add(status);
    }

    for (let i = 0; i < 5; i += 1) {
      const tray = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.055, 0.42), edgeMetal);
      tray.position.set(-1.02 + i * 0.34, 0.06, -0.52);
      hardware.add(tray);
    }

    const scanner = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.08, 0.52, 18), darkMetal);
    scanner.position.set(-0.98, 0.48, 0.58);
    scanner.rotation.z = -0.05;
    hardware.add(scanner);

    const scannerHead = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.11, 0.16), glowTeal);
    scannerHead.position.set(-0.98, 0.78, 0.58);
    hardware.add(scannerHead);

    const haloMaterial = new THREE.MeshBasicMaterial({
      color: "#24d6b3",
      transparent: true,
      opacity: 0.28,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
    });
    const halo = new THREE.Mesh(new THREE.TorusGeometry(1.38, 0.009, 8, 132), haloMaterial);
    halo.position.set(0.22, 0.28, 0.02);
    halo.rotation.set(1.18, 0.05, -0.16);
    hardware.add(halo);

    const amberHalo = new THREE.Mesh(new THREE.TorusGeometry(0.82, 0.007, 8, 96), haloMaterial.clone());
    amberHalo.material.color = amber;
    amberHalo.material.opacity = 0.2;
    amberHalo.position.set(0.22, 0.28, 0.03);
    amberHalo.rotation.set(1.18, 0.05, 0.72);
    hardware.add(amberHalo);

    const routeMaterial = new THREE.LineBasicMaterial({
      color: teal,
      transparent: true,
      opacity: 0.54,
      blending: THREE.AdditiveBlending,
    });
    const routeGroup = new THREE.Group();
    root.add(routeGroup);

    const routeStarts = new THREE.Vector3(1.18, -0.2, -0.08);
    const endpoints = [
      new THREE.Vector3(-3.4, 1.25, -1.3),
      new THREE.Vector3(-2.3, -1.55, -1.1),
      new THREE.Vector3(0.4, 1.72, -1.6),
      new THREE.Vector3(3.55, 1.08, -1.45),
      new THREE.Vector3(3.9, -1.05, -1.25),
    ];

    const pulses = [];
    endpoints.forEach((endpoint, index) => {
      const mid = routeStarts.clone().lerp(endpoint, 0.52);
      mid.y += index % 2 === 0 ? 0.24 : -0.14;
      const curve = new THREE.QuadraticBezierCurve3(routeStarts, mid, endpoint);
      const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(curve.getPoints(48)), routeMaterial.clone());
      line.userData.phase = index * 0.45;
      routeGroup.add(line);

      const node = new THREE.Mesh(new THREE.IcosahedronGeometry(0.055, 1), index === 1 ? glowAmber : glowTeal);
      node.position.copy(endpoint);
      node.userData.phase = index * 0.6;
      routeGroup.add(node);

      const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.038, 16, 16), index % 2 === 0 ? glowTeal : glowAmber);
      pulse.userData.curve = curve;
      pulse.userData.phase = index * 0.17;
      pulses.push(pulse);
      routeGroup.add(pulse);
    });

    const particlesGeometry = new THREE.BufferGeometry();
    const particleCount = 180;
    const particlePositions = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i += 1) {
      particlePositions[i * 3] = (Math.random() - 0.5) * 7.6;
      particlePositions[i * 3 + 1] = (Math.random() - 0.5) * 3.4;
      particlePositions[i * 3 + 2] = -1.8 - Math.random() * 1.4;
    }
    particlesGeometry.setAttribute("position", new THREE.BufferAttribute(particlePositions, 3));
    const particles = new THREE.Points(
      particlesGeometry,
      new THREE.PointsMaterial({
        color: cyan,
        size: 0.018,
        transparent: true,
        opacity: 0.48,
        blending: THREE.AdditiveBlending,
      }),
    );
    root.add(particles);

    const grid = new THREE.GridHelper(7, 18, 0x24d6b3, 0x25313a);
    grid.position.set(0.55, -1.1, -1.2);
    grid.rotation.x = 0.06;
    grid.material.transparent = true;
    grid.material.opacity = 0.13;
    root.add(grid);

    scene.add(new THREE.AmbientLight(0x9fb2b8, 1.4));
    const key = new THREE.DirectionalLight(0x7bdff2, 2.6);
    key.position.set(3, 4, 3);
    scene.add(key);
    const warm = new THREE.PointLight(0xf5a524, 2.2, 5);
    warm.position.set(1.1, 0.2, 1.5);
    scene.add(warm);

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const width = Math.max(1, rect.width);
      const height = Math.max(1, rect.height);
      camera.aspect = width / height;
      camera.position.set(0, 0.2, 7.1);
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    }

    function onPointerMove(event) {
      pointerX = (event.clientX / window.innerWidth - 0.5) * 2;
      pointerY = (event.clientY / window.innerHeight - 0.5) * 2;
    }

    function animate(time) {
      if (!isVisible) return;
      const elapsed = time * 0.001;
      root.rotation.y = pointerX * 0.035;
      root.rotation.x = -pointerY * 0.02;
      hardware.position.y = -0.55 + Math.sin(elapsed * 0.75) * 0.035;
      halo.rotation.z = elapsed * 0.2;
      halo.material.opacity = 0.2 + Math.sin(elapsed * 1.3) * 0.08;
      amberHalo.rotation.z = -elapsed * 0.26;
      amberHalo.material.opacity = 0.14 + Math.sin(elapsed * 1.1 + 1.2) * 0.06;
      routeGroup.children.forEach((child) => {
        const phase = child.userData.phase || 0;
        if (child.type === "Line") {
          child.material.opacity = 0.32 + Math.sin(elapsed * 1.8 + phase) * 0.16;
        } else {
          child.scale.setScalar(0.9 + Math.sin(elapsed * 2.2 + phase) * 0.18);
        }
      });
      pulses.forEach((pulse) => {
        const curve = pulse.userData.curve;
        const progress = (elapsed * 0.1 + pulse.userData.phase) % 1;
        pulse.position.copy(curve.getPointAt(progress));
        pulse.scale.setScalar(0.82 + Math.sin(elapsed * 4 + progress * 6) * 0.16);
      });
      particles.rotation.z = elapsed * 0.018;
      particles.rotation.y = Math.sin(elapsed * 0.18) * 0.08;
      renderer.render(scene, camera);
      frameId = requestAnimationFrame(animate);
    }

    function startLoop() {
      isVisible = true;
      if (!frameId) {
        frameId = requestAnimationFrame(animate);
      }
    }

    function stopLoop() {
      isVisible = false;
      if (frameId) {
        cancelAnimationFrame(frameId);
        frameId = 0;
      }
    }

    const observer = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        startLoop();
      } else {
        stopLoop();
      }
    });

    resize();
    renderer.render(scene, camera);
    startLoop();

    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    observer.observe(canvas);
  }
</script>
