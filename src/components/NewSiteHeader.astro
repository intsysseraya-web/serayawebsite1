---
const navItems = [
  { label: "Systems", href: "#systems" },
  { label: "Advantage", href: "#advantage" },
  { label: "Process", href: "#process" },
  { label: "Programs", href: "#programs" },
  { label: "Contact", href: "#contact" },
];
---

<div class="border-b border-white/10 bg-seraya-panel/80 text-xs text-seraya-muted">
  <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-5 py-2 text-center sm:justify-between">
    <a class="transition hover:text-seraya-text" href="#contact">RFQ response within one business day</a>
    <a class="transition hover:text-seraya-text" href="#contact">Kuala Lumpur HQ</a>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-white/10 bg-seraya-bg/88 backdrop-blur-xl">
  <div class="mx-auto flex min-h-16 w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-3">
    <a class="flex w-40 items-center sm:w-44" href="/new/" aria-label="Seraya System Integration home">
      <img
        src="/assets/brand/seraya-lockup-horizontal-reversed.svg"
        alt="Seraya System Integration"
        width="1150"
        height="260"
        class="h-auto w-full"
      />
    </a>

    <nav class="order-3 flex w-full flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.08em] text-seraya-muted md:order-2 md:w-auto">
      {navItems.map((item) => <a class="transition hover:text-seraya-text" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="order-2 flex items-center gap-2 md:order-3">
      <a
        class="hidden rounded-md border border-white/15 px-3 py-2 text-xs font-semibold text-seraya-text transition hover:border-seraya-cyan/70 sm:inline-flex"
        href="/old/"
      >
        Old site
      </a>
      <a
        class="rounded-md bg-seraya-accent px-3 py-2 text-xs font-semibold text-black transition hover:bg-seraya-cyan"
        href="mailto:hello@serayasystem.com"
      >
        Email RFQ
      </a>
    </div>
  </div>
</header>
