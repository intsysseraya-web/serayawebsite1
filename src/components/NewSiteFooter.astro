---
const footerLinks = [
  { label: "Systems", href: "/new/systems/" },
  { label: "Programs", href: "/new/programs/" },
  { label: "Company", href: "/new/about/" },
  { label: "RFQ", href: "/new/about/#contact" },
  { label: "Old site", href: "/old/" },
];
---

<footer class="border-t border-white/10 bg-black/30 px-5 py-12">
  <div class="mx-auto grid w-full max-w-7xl gap-8 md:grid-cols-[1.2fr_0.8fr] md:items-end">
    <div>
      <img
        src="/assets/brand/seraya-lockup-stacked-reversed.svg"
        alt="Seraya System Integration"
        width="860"
        height="620"
        class="h-auto w-32"
      />
      <p class="mt-5 max-w-lg text-sm leading-7 text-seraya-muted">
        Trading-led technology partner for GPU compute, servers, and workstation programs. Kuala Lumpur, Malaysia.
      </p>
    </div>

    <div class="flex flex-col gap-5 md:items-end">
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.08em] text-seraya-muted">
        {footerLinks.map((link) => <a class="transition hover:text-seraya-text" href={link.href}>{link.label}</a>)}
      </nav>
      <a class="text-sm text-seraya-text transition hover:text-seraya-cyan" href="mailto:hello@serayasystem.com">
        hello@serayasystem.com
      </a>
    </div>
  </div>
</footer>
