---
import NewSiteFooter from "../../components/NewSiteFooter.astro";
import NewSiteHeader from "../../components/NewSiteHeader.astro";
import NewSiteMotion from "../../components/NewSiteMotion.astro";
import SerayaContactBand from "../../components/SerayaContactBand.astro";
import SerayaCoreMap from "../../components/SerayaCoreMap.astro";
import SerayaProofPipeline from "../../components/SerayaProofPipeline.astro";
import SerayaHeroExperience from "../../components/SerayaHeroExperience.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  advantages,
  featuredLines,
  processSteps,
  programs,
  values,
} from "../../data/serayaContent";
---

<BaseLayout
  title="Seraya Systems Integration | Kuala Lumpur system integrator"
  description="Seraya Systems Integration is a Kuala Lumpur system integrator for traceable hardware supply, assembly, burn-in, and RFQ-led workstation and server programs."
  bodyClass="min-h-screen"
>
  <NewSiteHeader />

  <main class="overflow-hidden">
    <section class="relative isolate min-h-[62vh] overflow-hidden px-5 py-10 md:min-h-[calc(100vh-9rem)] md:py-20 lg:py-24">
      <SerayaHeroExperience />
      <div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,#050708_0%,rgba(5,7,8,0.94)_20%,rgba(5,7,8,0.62)_48%,rgba(5,7,8,0.16)_78%,rgba(5,7,8,0.04)_100%)]"></div>
      <div class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgba(5,7,8,0)_0%,rgba(5,7,8,0.2)_72%,#050708_100%)]"></div>

      <div class="seraya-hero-shell mx-auto flex w-full items-center">
        <div class="max-w-3xl py-6 md:py-12" data-hero-copy>
          <h1 class="max-w-4xl break-words text-4xl font-semibold text-seraya-text md:text-6xl lg:text-7xl">
            System integration for traceable hardware supply.
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-seraya-muted md:mt-7 md:text-lg md:leading-8">
            KL's system integrator for startups, studios, custom PC builds, and regional hardware programs. Authorised parts where possible, disciplined assembly, burn-in, and the same bench care for business and personal builds.
          </p>
          <div class="mt-8 flex flex-wrap gap-3 md:mt-9">
            <a class="rounded-md bg-seraya-accent px-5 py-3 text-sm font-semibold text-black transition hover:bg-seraya-cyan" href="#contact">
              Start an RFQ
            </a>
            <a class="rounded-md border border-white/15 bg-black/20 px-5 py-3 text-sm font-semibold text-seraya-text backdrop-blur transition hover:border-seraya-cyan/70" href="/new/systems/">
              View systems
            </a>
          </div>
          <dl class="mt-10 hidden max-w-2xl gap-4 text-sm text-seraya-muted sm:grid sm:grid-cols-3">
            <div class="border-l border-seraya-cyan/40 bg-black/15 pl-4">
              <dt class="font-semibold text-seraya-text">RFQ</dt>
              <dd>One business day response</dd>
            </div>
            <div class="border-l border-seraya-cyan/40 bg-black/15 pl-4">
              <dt class="font-semibold text-seraya-text">HQ</dt>
              <dd>Kuala Lumpur, Malaysia</dd>
            </div>
            <div class="border-l border-seraya-cyan/40 bg-black/15 pl-4">
              <dt class="font-semibold text-seraya-text">Flow</dt>
              <dd>Source, build, test, handoff</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-black/20 px-5 py-14 md:py-20">
      <div class="mx-auto grid w-full max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">Integration core</p>
          <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
            One supply-chain core, different customer handoffs.
          </h2>
          <p class="mt-5 text-lg leading-8 text-seraya-muted">
            Seraya sits in the middle of RFQ, authorised supply, batch matching, bench validation, serial capture, and warranty path. The customer only needs one accountable thread.
          </p>
        </div>
        <SerayaCoreMap />
      </div>
    </section>

    <section id="systems" class="px-5 py-20" data-reveal>
      <div class="mx-auto w-full max-w-7xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">Featured lines</p>
          <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
            Three ways to work with Seraya.
          </h2>
          <p class="mt-5 text-lg leading-8 text-seraya-muted">
            New builds, supplied parts, or old gear. The model stays the same: source responsibly, integrate carefully, and hand over hardware that is ready to use.
          </p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {featuredLines.map((line) => (
            <article class="seraya-lab-card group flex min-h-72 flex-col justify-between rounded-lg border border-white/10 bg-white/[0.035] p-6 transition hover:border-seraya-cyan/50 hover:bg-white/[0.055]" data-reveal-card>
              <div>
                <h3 class="text-xl font-semibold text-seraya-text">{line.title}</h3>
                <p class="mt-4 leading-7 text-seraya-muted">{line.body}</p>
              </div>
              <a class="mt-8 text-sm font-semibold text-seraya-cyan transition group-hover:text-seraya-text" href={line.href}>
                {line.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="advantage" class="border-y border-white/10 bg-black/20 px-5 py-20" data-reveal>
      <div class="mx-auto grid w-full max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">Small shop. Big advantage.</p>
          <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
            No layers, no wait-for-approval.
          </h2>
          <p class="mt-5 text-lg leading-8 text-seraya-muted">
            The old site says it plainly: you talk to the same team that sources, assembles, validates, and fixes the hardware.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {advantages.map((advantage) => (
            <article class="seraya-lab-card rounded-lg border border-white/10 bg-seraya-panel/60 p-5" data-reveal-card>
              <h3 class="text-lg font-semibold text-seraya-text">{advantage.title}</h3>
              <p class="mt-3 text-sm leading-7 text-seraya-muted">{advantage.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="process" class="px-5 py-20" data-reveal>
      <div class="mx-auto w-full max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">How it works</p>
            <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
              Turn an idea into tested, documented hardware.
            </h2>
            <p class="mt-5 max-w-xl text-lg leading-8 text-seraya-muted">
              No engineering degree required. Send the workload and constraints; Seraya returns a practical build path, then proves the handoff before hardware leaves the bench.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              {processSteps.map((step) => (
                <article class="seraya-mini-step rounded-lg border border-white/10 bg-white/[0.035] p-4" data-reveal-card>
                  <span>{step.step}</span>
                  <strong>{step.title}</strong>
                </article>
              ))}
            </div>
          </div>
          <SerayaProofPipeline />
        </div>
      </div>
    </section>

    <section id="programs" class="border-y border-white/10 bg-seraya-panel/35 px-5 py-20" data-reveal>
      <div class="mx-auto w-full max-w-7xl">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-seraya-cyan">Programs and updates</p>
          <h2 class="mt-4 text-3xl font-semibold text-seraya-text md:text-5xl">
            Structured support for repeat hardware needs.
          </h2>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {programs.map((program) => (
            <article class="seraya-lab-card rounded-lg border border-white/10 bg-black/25 p-6" data-reveal-card>
              <h3 class="text-xl font-semibold text-seraya-text">{program.title}</h3>
              <p class="mt-4 leading-7 text-seraya-muted">{program.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-20" data-reveal>
      <div class="mx-auto grid w-full max-w-7xl gap-4 md:grid-cols-3">
        {values.map((value) => (
          <article class="seraya-lab-card rounded-lg border border-seraya-accent/20 bg-seraya-accent/[0.06] p-6" data-reveal-card>
            <h3 class="text-xl font-semibold text-seraya-text">{value.title}</h3>
            <p class="mt-4 leading-7 text-seraya-muted">{value.body}</p>
          </article>
        ))}
      </div>
    </section>

    <SerayaContactBand />
  </main>

  <NewSiteFooter />
  <NewSiteMotion />
</BaseLayout>
